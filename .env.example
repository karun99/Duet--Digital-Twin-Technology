# Optional. Duet runs entirely on user-supplied keys with no environment at all.
#
# These variables only matter when you *deploy* Duet and want to offer a
# provider at no cost to visitors ("Use deployment key" appears in the connect
# screen). Leave them blank to require every visitor to bring their own key.

# Google AI Studio — enables search-grounded lookups, image avatars/sketches
# and the live voice link.
GEMINI_API_KEY=

# OpenRouter — any model, including the free router (openrouter/free).
OPENROUTER_API_KEY=

# NVIDIA NIM — build.nvidia.com models.
NVIDIA_API_KEY=

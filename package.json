{
  "name": "duet-digital-twin",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Duet \u2014 build a parallel consciousness from any model provider, governed by a local MAS/JATAKA layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node -e \"require('node:fs').writeFileSync('dist-test/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test \"dist-test/test/*.test.js\"",
    "test:coverage": "tsc -p tsconfig.test.json && node -e \"require('node:fs').writeFileSync('dist-test/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test --experimental-test-coverage \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "9"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
